# Copy this file to .credentials and fill in your actual values
# cp .credentials.example .credentials

# PocketBase Superuser (access /_/ admin UI)
# URL:      http://<tailscale-ip>:8091/_/
# Email:    <your-superuser-email>
# Password: <your-superuser-password>

# Admin Dashboard
# URL:      http://<tailscale-ip>:3001
# Email:    <your-admin-email>
# Password: <your-admin-password>

# Tailscale IP (run: tailscale ip -4)
# IP: <your-tailscale-ip>
# PocketBase: http://<tailscale-ip>:8091
# Admin:      http://<tailscale-ip>:3001
